DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.100.150
DJANGO_CSRF_TRUSTED_ORIGINS=https://192.168.100.150
DJANGO_SECURE_SSL_REDIRECT=false
PORTAL_INGEST_TOKEN=replace-with-a-separate-random-token
PORTAL_ARTIFACT_ROOT=./artifact-store
PORTAL_UPLOAD_ROOT=./uploads
PORTAL_ELF_UPLOAD_MAX_BYTES=33554432
PORTAL_SINGLE_ELF_BOARD_SLUGS=visionfive2,bananapi-f3,milkv-megrez
PORTAL_EXTERNAL_URL=https://192.168.100.150
JENKINS_TRIGGER_URL=https://192.168.100.150
JENKINS_TRIGGER_USER=replace-with-jenkins-service-user
JENKINS_TRIGGER_TOKEN=replace-with-jenkins-api-token
JENKINS_SINGLE_ELF_JOB=riscv-uart-single-elf
JENKINS_CA_FILE=/etc/riscv-ci-portal/jenkins-ca.crt

# Local development uses SQLite when DB_ENGINE is omitted.
# Apollo production values:
# DB_ENGINE=postgresql
# DB_NAME=riscv_portal
# DB_USER=riscv_portal
# DB_PASSWORD=replace-with-a-database-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
